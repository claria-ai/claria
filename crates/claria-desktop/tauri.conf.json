{
  "identifier": "com.claria.desktop",
  "productName": "Claria",
  "version": "0.21.0",
  "build": {
    "beforeBuildCommand": "npm --prefix ../claria-desktop-frontend install && npm --prefix ../claria-desktop-frontend run build",
    "beforeDevCommand": "npm --prefix ../claria-desktop-frontend install && npm --prefix ../claria-desktop-frontend run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../claria-desktop-frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Claria",
        "width": 1024,
        "height": 768,
        "minWidth": 640,
        "minHeight": 600
      }
    ]
  },
  "bundle": {
    "active": true,
    "licenseFile": "../../LICENSE",
    "targets": ["dmg", "nsis", "msi"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
